{
  "rules": {
    "farms": {
      "$code": {
        ".read": "auth != null",
        "owner": {
          ".write": "auth != null && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)"
        },
        "pub": {
          ".write": "auth != null && root.child('farms').child($code).child('owner').val() === auth.uid"
        },
        "pos": {
          ".write": "auth != null && root.child('farms').child($code).child('owner').val() === auth.uid"
        },
        "visitors": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "inbox": {
          ".write": "auth != null && root.child('farms').child($code).child('owner').val() === auth.uid",
          "$id": {
            ".write": "auth != null && !data.exists() && newData.child('from').val() === auth.uid",
            ".validate": "newData.hasChildren(['type', 'from', 'name'])"
          }
        }
      }
    }
  }
}
